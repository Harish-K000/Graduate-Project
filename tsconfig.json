{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "ESNext.AsyncIterable"],
    "types": ["node","jest"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "effect": ["./node_modules/effect/dist/dts/index"],
      "effect/*": ["./node_modules/effect/dist/dts/*"]
    },
    "outDir": "./dist",
    "baseUrl": "./"
  },
  "exclude": ["dist", "test", "**/*.spec.ts", "node_modules"]
}

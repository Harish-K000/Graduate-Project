{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "ESNext.AsyncIterable"]
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
